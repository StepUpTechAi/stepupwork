{
  "hooks": [
    "session.start",
    "session.end",
    "tool.call{tool=Bash}",
    "command.run",
    "ui.render{component=Pane}",
    "ui.render{component=AbovePrompt}",
    "ui.render{component=BesidePrompt}",
    "ui.render{component=ToolUse}",
    "ui.render{component=ContextMenu}"
  ],
  "calls": [
    "$.mcp.call",
    "$.mcp.connect",
    "$.ui.*",
    "$.clock.every",
    "$.clock.now",
    "$.prompt.fill",
    "$.state",
    "$.store"
  ],
  "never": [
    "$.http.fetch",
    "$.process.run",
    "$.fs.*",
    "tool.check",
    "prompt.submit",
    "$.model.complete"
  ],
  "hubRoutes": [
    "/mcp"
  ],
  "publicAddresses": [
    "https://stepuptech.ai/privacy"
  ],
  "limits": {
    "stringChars": 200,
    "skillChars": 1200,
    "moduleLines": 200
  },
  "hubAddress": "https://sut.stepupwork.com"
}
